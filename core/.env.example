# ─── تنظیمات اجباری
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-minimum-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,your-server-ip,localhost
VISIUNAPP_DB_NAME=visiunapp_db
VISIUNAPP_DB_USER=visiunapp_user
VISIUNAPP_DB_PASSWORD=strong-database-password
VISIUNAPP_DB_HOST=localhost
VISIUNAPP_DB_PORT=5432
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_DEFAULT_FROM_EMAIL=noreply@your-domain.com
SESSION_INACTIVITY_TIMEOUT=1800
